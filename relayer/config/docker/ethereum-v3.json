{
  "source": {
    "ethereum": {
      "endpoint": "${ETHEREUM_ENDPOINT}"
    },
    "contracts": {
      "Gateway": "${GATEWAY_CONTRACT}"
    },
    "channel-id": "${CHANNEL_ID}",
    "beacon": {
      "endpoint": "${BEACON_ENDPOINT}",
      "stateServiceEndpoint": "http://beacon-state-service:8080",
      "spec": {
        "syncCommitteeSize": 512,
        "slotsInEpoch": 32,
        "epochsPerSyncCommitteePeriod": 256,
        "forkVersions": {
          "deneb": ${FORK_DENEB},
          "electra": ${FORK_ELECTRA},
          "fulu": ${FORK_FULU},
          "gloas": ${FORK_GLOAS}
        }
      },
      "datastore": {
        "location": "/data/beacon",
        "maxEntries": 100
      }
    }
  },
  "sink": {
    "parachain": {
      "endpoint": "${BRIDGEHUB_ENDPOINT}",
      "maxWatchedExtrinsics": ${MAX_WATCHED_EXTRINSICS},
      "headerRedundancy": 20,
      "heartbeat-secs": 45
    },
    "ss58Prefix": ${SS58_PREFIX}
  },
  "min-message-relayer-fee-wei": "${ETHEREUM_V3_MIN_MESSAGE_RELAYER_FEE_WEI}",
  "tip": ${ETHEREUM_V3_TIP},
  "ignoreNonces": ${ETHEREUM_V3_IGNORE_NONCES},
  "deadNoncesPath": "${ETHEREUM_V3_DEAD_NONCES_PATH}",
  "ofac": {
    "enabled": ${OFAC_ENABLED},
    "apiKey": "${TRM_API_KEY}"
  },
  "gasEstimation": {
    "enabled": ${GAS_ESTIMATION_ENABLED},
    "binary-path": "/usr/local/bin/snowbridge-gas-estimator",
    "asset-hub-url": "${ASSETHUB_ENDPOINT}",
    "bridge-hub-url": "${BRIDGEHUB_ENDPOINT}",
    "service-fee-recipients": ${SERVICE_FEE_RECIPIENTS}
  }
}
