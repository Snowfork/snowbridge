# Required Envs

## Network config(polkadot_mainnet|westend_sepolia|paseo_sepolia)
NODE_ENV=

## Public accounts for build-only transfer tests
SUBSTRATE_ACCOUNT_PUBLIC=
KUSAMA_ACCOUNT_PUBLIC=
ETHEREUM_ACCOUNT_PUBLIC=

## Infura keys
REACT_APP_INFURA_KEY=

# Optional Envs with default value

## GRAPHQL API endpoint for the indexer
GRAPHQL_API_URL=https://snowbridge.squids.live/snowbridge-subsquid-polkadot:production/api/graphql

DRY_RUN=false

## Optional volume fee for the v2 E<->P transfer scripts (whole USD values).
## Set all three to charge a service fee, deposited to SERVICE_FEE_RECIPIENT
## (Asset Hub AccountId32) on Asset Hub. With any unset, no fee is charged.
VOLUME_FEE_TX_VALUE_USD=
VOLUME_FEE_ETH_USD_PRICE=
SERVICE_FEE_RECIPIENT=
