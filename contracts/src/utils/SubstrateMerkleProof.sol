pragma solidity 0.8.34;

// Used to verify merkle proofs generated by substrate's `binary-merkle-tree`. See:
// https://github.com/paritytech/polkadot-sdk/blob/48a8a0689248e4fba3e6615e0c8c9c83f9df3343/substrate/utils/binary-merkle-tree/src/lib.rs#L359
// The crucial property reproduced below is the PROMOTION rule for odd layers: when a layer has an
// odd number of nodes the lone trailing node is carried up to the next layer UNCHANGED (not hashed
// with itself) — see `merkelize_row` upstream ("Odd number of items. Promote the item to the upper
// layer."). The matching proof generator used in production is the relayer's
// `relayer/crypto/merkle/merkle.go` (`Tree.Hash` / `Tree.MerklePath`, which `continue`s past the
// promoted node and emits no sibling for it). Keep all three in sync.
library SubstrateMerkleProof {
    /**
     * @notice Verify that a specific leaf element is part of the Merkle Tree at a specific position in the tree
     *
     * The tree would have been constructed using
     * https://docs.rs/binary-merkle-tree/latest/binary_merkle_tree/fn.merkle_root.html
     *
     * This implementation adapted from
     * https://docs.rs/binary-merkle-tree/latest/binary_merkle_tree/fn.verify_proof.html
     *
     * @param root the root of the merkle tree
     * @param leaf the leaf which needs to be proven
     * @param position the position of the leaf, index starting with 0
     * @param width the width or number of leaves in the tree
     * @param proof the array of proofs to help verify the leaf's membership, ordered from leaf to root
     * @return a boolean value representing the success or failure of the operation
     */
    function verify(
        bytes32 root,
        bytes32 leaf,
        uint256 position,
        uint256 width,
        bytes32[] calldata proof
    ) internal pure returns (bool) {
        (bool valid, bytes32 node) = computeRoot(leaf, position, width, proof);
        return valid && root == node;
    }

    /**
     * @notice Reconstruct the merkle root from a leaf and its proof.
     * @dev Walk the tree by geometry (not by proof.length) so that the number of sibling hashes
     *      is dictated by (position, width). A lone trailing node in an odd-width layer is
     *      promoted to the next layer unchanged and consumes no proof element, exactly as
     *      substrate's binary-merkle-tree builds the tree. `valid` is true only when `position`
     *      is in range and the proof length matches the canonical path for the leaf, which binds
     *      it to a single leaf position: a short (lone-promoted) proof can no longer alias onto
     *      the many other indices that share its leading decision bits. `root` is `bytes32(0)`
     *      whenever `valid` is false, so a caller that forgets to check `valid` fails closed.
     * @return valid whether the proof is structurally valid for `(position, width)`
     * @return root the reconstructed root, or `bytes32(0)` when `valid` is false
     */
    function computeRoot(bytes32 leaf, uint256 position, uint256 width, bytes32[] calldata proof)
        internal
        pure
        returns (bool, bytes32)
    {
        bytes32 node = leaf;
        if (position >= width) {
            return (false, bytes32(0));
        }
        uint256 i = 0;
        unchecked {
            while (width > 1) {
                // Promotion rule: the lone trailing node of an odd-width layer is carried up
                // unchanged and has no sibling, so it consumes no proof element. Mirrors
                // `merkelize_row` in substrate's binary-merkle-tree:
                // https://github.com/paritytech/polkadot-sdk/blob/48a8a0689248e4fba3e6615e0c8c9c83f9df3343/substrate/utils/binary-merkle-tree/src/lib.rs#L397
                bool promoted = position + 1 == width && width & 1 == 1;
                if (!promoted) {
                    // A genuine sibling is required here. A proof too short for this leaf's
                    // canonical path is invalid.
                    if (i >= proof.length) {
                        return (false, bytes32(0));
                    }
                    if (position & 1 == 1) {
                        node = efficientHash(proof[i], node);
                    } else {
                        node = efficientHash(node, proof[i]);
                    }
                    i++;
                }
                position = position >> 1;
                width = ((width - 1) >> 1) + 1;
            }
        }
        // The proof must contain exactly the canonical number of siblings -- no more, no less.
        if (i == proof.length) {
            return (true, node);
        }
        return (false, bytes32(0));
    }

    /**
     * @notice Root of the tree containing `leaves` at `positions`, sharing siblings between
     *      paths. Folds one layer at a time: two known siblings are hashed together, otherwise
     *      the next element of `siblings` is used. `siblings` is therefore ordered layer by
     *      layer, by ascending position within a layer, and holds only nodes that cannot be
     *      computed from the leaves. Same promotion rule as `computeRoot`.
     *
     *      `valid` is false unless `positions` is non-empty, strictly ascending and below
     *      `width`, and `siblings` is consumed exactly.
     *
     *      Overwrites `positions` and `leaves`.
     */
    function computeMultiRoot(
        uint256[] memory positions,
        bytes32[] memory leaves,
        uint256 width,
        bytes32[] calldata siblings
    ) internal pure returns (bool valid, bytes32 root) {
        uint256 n = positions.length;
        if (n == 0 || n != leaves.length) {
            return (false, bytes32(0));
        }
        for (uint256 i = 0; i < n; i++) {
            if (positions[i] >= width || (i > 0 && positions[i] <= positions[i - 1])) {
                return (false, bytes32(0));
            }
        }

        uint256 next;
        unchecked {
            while (width > 1) {
                // Parents of a strictly ascending layer are strictly ascending, so the layer
                // can be rewritten in place.
                uint256 m;
                for (uint256 i = 0; i < n; i++) {
                    uint256 position = positions[i];
                    bytes32 node = leaves[i];
                    if (position + 1 == width && width & 1 == 1) {
                        // Lone trailing node of an odd-width layer: promoted unchanged.
                    } else if (position & 1 == 0 && i + 1 < n && positions[i + 1] == position + 1)
                    {
                        node = efficientHash(node, leaves[i + 1]);
                        i++;
                    } else {
                        if (next >= siblings.length) {
                            return (false, bytes32(0));
                        }
                        if (position & 1 == 1) {
                            node = efficientHash(siblings[next], node);
                        } else {
                            node = efficientHash(node, siblings[next]);
                        }
                        next++;
                    }
                    positions[m] = position >> 1;
                    leaves[m] = node;
                    m++;
                }
                n = m;
                width = ((width - 1) >> 1) + 1;
            }
        }
        if (n != 1 || next != siblings.length) {
            return (false, bytes32(0));
        }
        return (true, leaves[0]);
    }

    function efficientHash(bytes32 a, bytes32 b) internal pure returns (bytes32 value) {
        /// @solidity memory-safe-assembly
        assembly {
            mstore(0x00, a)
            mstore(0x20, b)
            value := keccak256(0x00, 0x40)
        }
    }
}
